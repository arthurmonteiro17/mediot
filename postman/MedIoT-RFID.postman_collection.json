{
  "info": {
    "name": "MedIoT RFID",
    "description": "Testes da API RFID do MedIoT (ESP8266).\n\n**Ordem sugerida:**\n1. Bootstrap\n2. Saída (Arthur + Furadeira)\n3. Devolução (Arthur + Furadeira)\n4. Saída de novo (Arthur)\n5. Enrico tenta devolver → 403\n6. Arthur devolve (limpa)\n7. UID inválido → 404\n8. Listar movimentações\n\nUIDs reais do hardware (com dois-pontos).\n\nProdução: https://mediot.online\nLocal: http://127.0.0.1:43123",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://mediot.online"
    }
  ],
  "item": [
    {
      "name": "1. Bootstrap",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/bootstrap",
        "description": "Lista hospital, produtos, staff e movimentações. Esperado: 200."
      }
    },
    {
      "name": "2. RFID Scan — Saída (Arthur + Furadeira)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userUid\": \"67:52:B0:A0\",\n  \"productUid\": \"F5:76:82:B1\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/rfid/scan",
        "description": "Arthur (67:52:B0:A0) + Furadeira (F5:76:82:B1). Esperado: 201 action saida."
      }
    },
    {
      "name": "3. RFID Scan — Devolução (Arthur)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userUid\": \"67:52:B0:A0\",\n  \"productUid\": \"F5:76:82:B1\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/rfid/scan",
        "description": "Mesmo Arthur + Furadeira. Esperado: 201 action devolucao."
      }
    },
    {
      "name": "4. RFID Scan — Saída de novo (Arthur, prepara 403)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userUid\": \"67:52:B0:A0\",\n  \"productUid\": \"F5:76:82:B1\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/rfid/scan",
        "description": "Arthur retira de novo. Esperado: 201 action saida."
      }
    },
    {
      "name": "5. RFID Scan — Outro usuário tenta devolver",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userUid\": \"77:0C:B2:A0\",\n  \"productUid\": \"F5:76:82:B1\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/rfid/scan",
        "description": "Enrico (77:0C:B2:A0) tenta devolver Furadeira do Arthur. Esperado: 403."
      }
    },
    {
      "name": "6. RFID Scan — Devolução (Arthur limpa estado)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userUid\": \"67:52:B0:A0\",\n  \"productUid\": \"F5:76:82:B1\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/rfid/scan",
        "description": "Arthur devolve. Esperado: 201 action devolucao."
      }
    },
    {
      "name": "7. RFID Scan — UID inválido",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userUid\": \"00:00:00:00\",\n  \"productUid\": \"FF:FF:FF:FF\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/rfid/scan",
        "description": "UIDs fictícios. Esperado: 404."
      }
    },
    {
      "name": "8. Listar movimentações",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/movements",
        "description": "Histórico. Esperado: 200."
      }
    }
  ]

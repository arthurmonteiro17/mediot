{
  "name": "mediot",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --port 43123",
    "build": "prisma generate && next build",
    "start": "next start --port ${PORT:-43123}",
    "start:railway": "prisma migrate deploy && prisma db seed && next start --port ${PORT:-43123}",
    "lint": "eslint",
